/AndroidUnity/Assets/Firebase/Plugins/x86_64/*.bundle
/AndroidUnity/Assets/Firebase/Plugins/x86_64/*.bundle.meta
/AndroidUnity/Assets/Firebase/Plugins/x86_64/*.so
/AndroidUnity/Assets/Firebase/Plugins/x86_64/*.so.meta
